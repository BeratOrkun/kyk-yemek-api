# API güvenliği: Yönetim endpoint'lerini açmak için uzun ve rastgele bir anahtar belirle.
ADMIN_API_KEY=change-this-to-a-long-random-secret

# Yerel geliştirme için varsayılan dosya. Railway Volume kullanıyorsan /data/kyk.db yap.
DATABASE_PATH=./data/kyk.db

# Otomatik senkronizasyon aralığı (dakika)
SYNC_INTERVAL_MINUTES=120

# İstek geldiğinde önbellek bu süreden eskiyse kaynağı tekrar kontrol et (dakika)
CACHE_TTL_MINUTES=60

# Arka plan senkronizasyonunda taranacak şehirler. Başlangıçta gereksiz istek atmamak için Ankara.
# Örnek: Ankara,İstanbul,İzmir,Eskişehir
SYNC_CITIES=Ankara

# Kaynak sırası: kykyemek,kykyurtmenu
SOURCE_ORDER=kykyemek,kykyurtmenu

# API CORS. Mobil uygulamadan erişim için * kullanılabilir.
CORS_ORIGINS=*
